// The response copied to another local, the renamed field read through it.
package scenario

import (
	"context"

	"example.com/sdk"
)

// NameOf is a customer's name.
func NameOf(ctx context.Context, client *sdk.Client, id string) (string, error) {
	customer, err := client.Customers.Get(ctx, id)
	if err != nil {
		return "", err
	}
	current := customer
	return current.DisplayName, nil
}
