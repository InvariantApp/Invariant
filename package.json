{
  "name": "invariant",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc --build",
    "build": "pnpm -r --workspace-concurrency=1 --filter \"./packages/*\" run build",
    "check:packages": "node --import tsx scripts/check-packages.mts",
    "bundle:action": "pnpm --filter @invariant/action bundle",
    "bundle:sidecar": "cd packages/sidecar && tsdown --config tsdown.image.config.ts && cp ../../LICENSE ../../NOTICE image/",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "e2e": "vitest run e2e",
    "demo": "tsx e2e/demo.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "eval:record": "node --env-file=.env --import tsx eval/record.mts",
    "app:register": "node --import tsx scripts/register-app.mts",
    "app:status": "node --import tsx scripts/app-status.mts",
    "proving:servers": "node --import tsx proving/servers/run.mts",
    "proving:traffic": "node --import tsx proving/traffic/run.mts",
    "proving:corpus": "node --env-file-if-exists=.env --import tsx proving/corpus/run.mts",
    "proving:discover": "node --import tsx proving/corpus/discover-git.mts",
    "ci:local": "bash scripts/ci-local.sh"
  },
  "devDependencies": {
    "@acme/sdk-v3": "workspace:*",
    "@anthropic-ai/sdk": "0.126.0",
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.14",
    "@changesets/cli": "3.0.3",
    "@electric-sql/pglite": "^0.5.8",
    "@fixtures/provider-acme": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "@invariant/bundle": "workspace:*",
    "@invariant/cli": "workspace:*",
    "@invariant/compiler": "workspace:*",
    "@invariant/contract": "workspace:*",
    "@invariant/diff": "workspace:*",
    "@invariant/eval": "workspace:*",
    "@invariant/flags": "workspace:*",
    "@invariant/github": "workspace:*",
    "@invariant/ir": "workspace:*",
    "@invariant/migrate-ts": "workspace:*",
    "@invariant/proposer": "workspace:*",
    "@invariant/runtime": "workspace:*",
    "@invariant/sidecar": "workspace:*",
    "@invariant/verifier": "workspace:*",
    "@types/node": "^22.20.4",
    "@types/qs": "^6.15.1",
    "@typesafe-ai/sdk": "^0.6.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^18.0.1",
    "fast-check": "^4.10.1",
    "publint": "0.3.24",
    "qs": "6.16.0",
    "swagger2openapi": "7.0.8",
    "ts-morph": "^28.0.0",
    "tsdown": "0.23.0",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "verdaccio": "6.10.3",
    "vitest": "^5.0.1"
  }
}
