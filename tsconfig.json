{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "allowImportingTsExtensions": true
  },
  "include": [
    "packages/*/src/**/*.ts",
    "apps/*/src/**/*.ts",
    "fixtures/*/src/**/*.ts",
    "fixtures/*/sdk/**/*.d.ts",
    "e2e/**/*.ts",
    "*.config.ts",
    "tsdown.shared.ts",
    "packages/*/tsdown*.ts",
    "scripts/**/*.mts",
    "proving/**/*.mts",
    "proving/**/*.ts",
    "eval/**/*.mts"
  ],
  "exclude": ["**/node_modules", "**/dist"]
}
