    {
      "name": "netbox",
      "language": "Python",
      "repo": "netbox-community/netbox",
      "image": "netboxcommunity/netbox",
      "server": {
        "port": 8080,
        "ready": "/api/",
        "readySeconds": 600,
        "compose": "compose/netbox.yaml",
        "secrets": {
          "NETBOX_TOKEN": {
            "suite": "tests/integration/conftest.py",
            "pattern": "token=\"([0-9a-f]{40})\""
          },
          "NETBOX_DB_PASSWORD": {
            "random": 16
          },
          "NETBOX_REDIS_PASSWORD": {
            "random": 16
          },
          "NETBOX_REDIS_CACHE_PASSWORD": {
            "random": 16
          },
          "NETBOX_SECRET_KEY": {
            "random": 32
          },
          "NETBOX_SUPERUSER_PASSWORD": {
            "random": 16
          }
        }
      },
      "spec": {
        "served": "/api/schema/?format=json",
        "headers": {
          "Authorization": "Token {NETBOX_TOKEN}",
          "Accept": "application/json"
        }
      },
      "suite": {
        "repo": "netbox-community/pynetbox",
        "sparse": [],
        "dir": ".",
        "install": [
          ["uv", "venv", "--quiet", "--python", "3.10", "{env}"],
          [
            "env",
            "SETUPTOOLS_SCM_PRETEND_VERSION=7.1.0",
            "uv",
            "pip",
            "install",
            "--quiet",
            "--python",
            "{env}/bin/python",
            "-r",
            "requirements-dev.txt",
            "."
          ]
        ],
        "run": [
          "pytest",
          "tests/integration",
          "-p",
          "no:docker",
          "-p",
          "no:cacheprovider",
          "--netbox-versions=3.5",
          "--url-override={url}",
          "--junitxml",
          "{report}"
        ],
        "select": ["-k", "{select}"],
        "env": {}
      },
      "releases": {
        "v3.5.9": {
          "commit": "0dbfbf6941d580b19948c06aecc33161d5575a92",
          "digest": "sha256:673b90015e6bc916d712a2e94ac62849ee9c221ccd7bce8c226e2d060e333ddf",
