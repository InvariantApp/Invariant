          "digest": "sha256:cf8a16f61d96c5d15cf5c639129662390e4b42685ed9c94ab4e344edeceb9a70"
        }
      },
      "pairs": [["v3.5.9", "v3.6.9"]]
    },
    {
      "name": "meilisearch",
      "language": "Rust",
      "repo": "meilisearch/meilisearch",
      "image": "getmeili/meilisearch-enterprise",
      "server": {
        "port": 7700,
        "ready": "/health",
        "env": {
          "MEILI_MASTER_KEY": "masterKey",
          "MEILI_NO_ANALYTICS": "true",
          "MEILI_EXPERIMENTAL_ALLOWED_IP_NETWORKS": "any"
        }
      },
      "spec": {
        "asset": "meilisearch-openapi.json"
      },
      "suite": {
        "repo": "meilisearch/meilisearch-js",
        "sparse": [],
        "dir": ".",
        "install": [["pnpm", "install", "--frozen-lockfile"]],
        "run": [
          "pnpm",
          "exec",
          "vitest",
          "run",
          "--reporter=default",
          "--reporter=junit",
          "--outputFile.junit={report}"
        ],
        "select": ["-t", "{select}"],
        "env": {
          "MEILISEARCH_URL": "{url}"
        }
      },
      "releases": {
        "v1.53.2": {
