      "pairs": [
        ["v1.12.0", "v1.13.0"],
        ["v1.13.0", "v1.14.0"],
        ["v1.14.0", "v1.15.0"],
        ["v1.15.0", "v1.16.0"],
        ["v1.16.0", "v1.17.0"],
