    {
      "name": "meilisearch",
      "language": "Rust",
      "repo": "meilisearch/meilisearch",
      "image": "getmeili/meilisearch-enterprise",
      "server": {
        "port": 7700,
        "ready": "/health",
        "env": {
          "MEILI_MASTER_KEY": "{MEILI_KEY}",
          "MEILI_NO_ANALYTICS": "true",
          "MEILI_EXPERIMENTAL_ALLOWED_IP_NETWORKS": "any"
        },
        "secrets": {
          "MEILI_KEY": {
            "suite": "tests/utils/meilisearch-test-utils.ts",
            "pattern": "MASTER_KEY = \"([^\"]+)\""
          }
        }
      },
      "spec": {
        "asset": "meilisearch-openapi.json"
      },
      "suite": {
        "repo": "meilisearch/meilisearch-js",
        "sparse": [],
        "dir": ".",
        "install": [["pnpm", "install", "--frozen-lockfile"]],
        "run": [
          "pnpm",
          "exec",
          "vitest",
          "run",
          "--reporter=default",
          "--reporter=junit",
          "--outputFile.junit={report}"
        ],
        "select": ["-t", "{select}"],
        "env": {
          "MEILISEARCH_URL": "{url}"
        }
      },
      "releases": {
        "v1.53.2": {
          "commit": "ec006cecec6f684b1dcaee093a45ab4c05707127",
          "digest": "sha256:9ff4496a42a7c1837eba030a09af21ccbcac992542231afdb50253b440ec5a89",
