{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/*.tsbuildinfo",
      "!fixtures/consumer-b-types-v2/src/acme-types.ts",
      "!fixtures/consumer-pinned/src/clients.ts",
      "!conformance/vectors.json",
      "!proving/**/results*.json",
      "!proving/corpus/manifest.json",
      "!proving/replay/index.json",
      "!proving/replay/sites.json",
      "!packages/action/bundle",
      "!packages/client/src/schema.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 90
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "useConst": "error",
        "noNonNullAssertion": "error",
        "noParameterProperties": "error"
      },
      "complexity": {
        "useLiteralKeys": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all"
    }
  }
}
