{
  "name": "@invariant-app/diff",
  "version": "0.3.0",
  "description": "Structural OpenAPI diff via oasdiff, with Invariant's breaking-change policy",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InvariantApp/Invariant.git",
    "directory": "packages/diff"
  },
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "sbom.cdx.json"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "node ../../scripts/prepack.mjs"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@invariant-app/contract": "workspace:*",
    "@invariant-app/ir": "workspace:*"
  },
  "optionalDependencies": {
    "@invariant-app/oasdiff-linux-x64": "workspace:*",
    "@invariant-app/oasdiff-linux-arm64": "workspace:*",
    "@invariant-app/oasdiff-darwin": "workspace:*",
    "@invariant-app/oasdiff-win32-x64": "workspace:*",
    "@invariant-app/oasdiff-win32-arm64": "workspace:*"
  }
}
