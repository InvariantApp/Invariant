{
  "name": "@invariant-app/proposer",
  "version": "0.4.0",
  "description": "Drafts candidate Changes from a structural diff. Proposals only: nothing here can ship.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InvariantApp/Invariant.git",
    "directory": "packages/proposer"
  },
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "sbom.cdx.json"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "node ../../scripts/prepack.mjs"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@invariant-app/contract": "workspace:*",
    "@invariant-app/ir": "workspace:*",
    "@invariant-app/runtime": "workspace:*",
    "@typesafe-ai/sdk": "^0.6.0"
  }
}
