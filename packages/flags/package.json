{
  "name": "@invariant-app/flags",
  "version": "0.5.0",
  "description": "Reads kill-switch flags from a file or the environment, with last-known-good semantics",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InvariantApp/Invariant.git",
    "directory": "packages/flags"
  },
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "sbom.cdx.json"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "node ../../scripts/prepack.mjs"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@invariant-app/runtime": "workspace:*",
    "@invariant-app/client": "workspace:*"
  }
}
