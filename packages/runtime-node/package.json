{
  "name": "@invariant/runtime-node",
  "version": "0.1.0",
  "description": "The runtime in any Node server: Express, Koa, Fastify, NestJS, Next.js or plain node:http, through one request listener or Connect middleware",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InvariantApp/Invariant.git",
    "directory": "packages/runtime-node"
  },
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "node ../../scripts/prepack.mjs"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@invariant/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/koa": "3.0.3",
    "express": "5.2.1",
    "express4": "npm:express@4.22.3",
    "fastify": "5.12.5",
    "koa": "3.2.1"
  }
}
