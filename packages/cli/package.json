{
  "name": "@invariant-app/cli",
  "version": "0.2.0",
  "description": "The invariant command, run by a provider in their own CI",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InvariantApp/Invariant.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "bin": {
    "invariant": "./src/main.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./invariant.schema.json": "./invariant.schema.json"
  },
  "files": [
    "dist",
    "invariant.schema.json",
    "README.md",
    "LICENSE",
    "NOTICE",
    "sbom.cdx.json"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "node ../../scripts/prepack.mjs"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./invariant.schema.json": "./invariant.schema.json"
    },
    "bin": {
      "invariant": "./dist/main.js"
    }
  },
  "dependencies": {
    "@invariant-app/bundle": "workspace:*",
    "@invariant-app/client": "workspace:*",
    "@invariant-app/compiler": "workspace:*",
    "@invariant-app/contract": "workspace:*",
    "@invariant-app/diff": "workspace:*",
    "@invariant-app/ir": "workspace:*",
    "@invariant-app/proposer": "workspace:*",
    "@invariant-app/verifier": "workspace:*",
    "ajv": "^8.20.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@invariant-app/runtime": "workspace:*"
  }
}
