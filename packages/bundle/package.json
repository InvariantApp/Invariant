{
  "name": "@invariant-app/bundle",
  "version": "0.4.0",
  "description": "The signed release envelope: changes, contract digests, evidence and compiled digests, content addressed and reproducible",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InvariantApp/Invariant.git",
    "directory": "packages/bundle"
  },
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./well-known.schema.json": "./well-known.schema.json"
  },
  "files": [
    "dist",
    "well-known.schema.json",
    "README.md",
    "LICENSE",
    "NOTICE",
    "sbom.cdx.json"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "node ../../scripts/prepack.mjs"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./well-known.schema.json": "./well-known.schema.json"
    }
  },
  "dependencies": {
    "@invariant-app/contract": "workspace:*",
    "@invariant-app/ir": "workspace:*",
    "@invariant-app/verifier": "workspace:*"
  }
}
