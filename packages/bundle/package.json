{
  "name": "@invariant/bundle",
  "version": "0.1.0",
  "description": "The signed release envelope: changes, contract digests, evidence and compiled digests, content addressed and reproducible",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InvariantApp/Invariant.git",
    "directory": "packages/bundle"
  },
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "node ../../scripts/prepack.mjs"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@invariant/contract": "workspace:*",
    "@invariant/ir": "workspace:*",
    "@invariant/verifier": "workspace:*"
  }
}
