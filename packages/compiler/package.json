{
  "name": "@invariant/compiler",
  "version": "0.1.0",
  "description": "Type-checks Changes, proves closure against the new contract, and projects compiled programs",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InvariantApp/Invariant.git",
    "directory": "packages/compiler"
  },
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "node ../../scripts/prepack.mjs"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@invariant/contract": "workspace:*",
    "@invariant/diff": "workspace:*",
    "@invariant/ir": "workspace:*",
    "@invariant/decimal": "workspace:*",
    "@invariant/runtime": "workspace:*"
  }
}
