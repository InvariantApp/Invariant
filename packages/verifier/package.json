{
  "name": "@invariant/verifier",
  "version": "0.1.0",
  "description": "Proves a release is safe: lens laws, chain equivalence, differential base-vs-head, conformance, and the evidence records for each",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InvariantApp/Invariant.git",
    "directory": "packages/verifier"
  },
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "node ../../scripts/prepack.mjs"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@invariant/compiler": "workspace:*",
    "@invariant/contract": "workspace:*",
    "@invariant/decimal": "workspace:*",
    "@invariant/diff": "workspace:*",
    "@invariant/ir": "workspace:*",
    "@invariant/runtime": "workspace:*",
    "fast-check": "^4.10.1",
    "yaml": "^2.8.1"
  }
}
