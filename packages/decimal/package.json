{
  "name": "@invariant-app/decimal",
  "version": "0.1.0",
  "description": "Exact decimal-string arithmetic. No dependencies, no floating point.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InvariantApp/Invariant.git",
    "directory": "packages/decimal"
  },
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
